{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "./node_modules/next/dist/bin/next",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "migration-status",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');const root=p.resolve('migration-status');const t={'.html':'text/html','.json':'application/json','.png':'image/png'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';const fp=p.join(root,u);if(!fp.startsWith(root)){r.writeHead(403);return r.end()}f.readFile(fp,(e,b)=>{if(e){r.writeHead(404);return r.end('not found')}r.writeHead(200,{'Content-Type':t[p.extname(fp)]||'application/octet-stream','Cache-Control':'no-store'});r.end(b)})}).listen(4321)"
      ],
      "port": 4321
    }
  ]
}