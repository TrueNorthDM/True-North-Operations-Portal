# The portal's scheduled jobs on its own server (migration plan, steps p4-crontab
# and p3-cron), in UTC. src/lib/cron-schedule.test.ts checks each line calls a
# job that exists.
#
# Install as root:  crontab -u portal /opt/tnportal/app/deploy/cron/portal.crontab
# Each line calls one job on the portal running on this machine (run.sh).
CRON_TZ=UTC
SHELL=/bin/bash
PORTAL_DIR=/opt/tnportal/app

0 1,5,9,13,17,21 * * *   $PORTAL_DIR/deploy/cron/run.sh /api/cron/ingest
30 1,5,9,13,17,21 * * *  $PORTAL_DIR/deploy/cron/run.sh /api/cron/tsheets-sync
0 9 * * *                $PORTAL_DIR/deploy/cron/run.sh /api/cron/health
45 1,5,9,13,17,21 * * *  $PORTAL_DIR/deploy/cron/run.sh /api/cron/clocky-delta
15 1,5,9,13,17,21 * * *  $PORTAL_DIR/deploy/cron/run.sh /api/cron/monday-worklist
*/15 * * * *             $PORTAL_DIR/deploy/cron/run.sh /api/cron/daily-summary
